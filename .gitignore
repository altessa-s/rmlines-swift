# SwiftPM
.build/
.swiftpm/
Package.resolved

# What Scripts/build-xcframework.sh produces: the archives it passes to
# `xcodebuild -create-xcframework` and the framework itself. Output, and the
# consumer keeps its own copy of the artefact.
build/
*.xcframework

.DS_Store

# Generated by XcodeGen from project.yml, and only so that
# Scripts/build-xcframework.sh has a framework target to archive.
RMLines.xcodeproj/

# The knowledge graph /graphify builds from this tree: the graph itself, its
# report, the rendered page and the extraction cache. Derived from the sources
# and rebuilt on demand, and the cache holds absolute paths of this machine.
graphify-out/
